MONGODB_URI=mongodb://root:change-me@localhost:27017/veklo?authSource=admin
# Al menos 32 caracteres aleatorios (ej: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
# OAuth Google (Web Client ID de Google Cloud)
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
MONGO_PORT=27017

# URL pública de la app (usada en links de emails)
APP_URL=https://tudominio.com
# Zona horaria del negocio: define qué es "hoy" en el dashboard (opcional)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Email - Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=veklo <noreply@tudominio.com>
# Casilla que recibe los avisos internos (ej: pedidos de arrepentimiento)
SUPPORT_EMAIL=hola@veklo.app

# Suscripción - MercadoPago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Token compartido en la query del webhook: /api/billing/mercadopago/webhook?token=...
MERCADOPAGO_WEBHOOK_TOKEN=replace-with-a-long-random-token
# Opcional en sandbox: forzar pagador de prueba sin cambiar el email del usuario en tu app
MERCADOPAGO_TEST_PAYER_EMAIL=test_payer_123456@testuser.com

# Tareas programadas (/api/cron/*): se envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=replace-with-a-long-random-secret
